{
  "expo": {
    "name": "اركب",
    "slug": "arkab-managil",
    "owner": "omer123mnm",
    "extra": {
      "eas": {
        "projectId": "653d655f-1c9e-4b85-b8b6-ccc819b2943b"
      }
    },
    "version": "0.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.arkab.managil",
      "versionCode": 8,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06432D",
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "rides",
          "color": "#06432D"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم أركب موقعك لتحديد نقطة الانطلاق ومتابعة الرحلة.",
          "locationAlwaysAndWhenInUsePermission": "يستخدم أركب موقع الكابتن في الخلفية أثناء الرحلة النشطة فقط لمشاركته مع الراكب.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج أركب إلى الوصول إلى الصور لاختيار صورة الملف الشخصي للكابتن."
        }
      ]
    ],
    "icon": "./assets/logo.png"
  }
}
