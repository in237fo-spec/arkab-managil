{
  "expo": {
    "name": "اركب",
    "slug": "arkab-managil",
    "owner": "omer123mnm",
    "extra": {
      "eas": {
        "projectId": "653d655f-1c9e-4b85-b8b6-ccc819b2943b"
      }
    },
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.arkab.managil",
      "versionCode": 14,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06432D",
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "rides",
          "color": "#06432D"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم أركب موقعك لتحديد نقطة الانطلاق ومتابعة الرحلة.",
          "locationAlwaysAndWhenInUsePermission": "يستخدم أركب موقع الكابتن أثناء التوفر أو الرحلة، وموقع الراكب فقط عندما يختار مشاركة تتبعه المباشر. يمكنك إيقاف المشاركة.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج أركب إلى الوصول إلى الصور لاختيار صورة الملف الشخصي للكابتن."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم أركب التحقق البيومتري في الهاتف لفتح حسابك إذا فعّلت هذا الخيار."
        }
      ]
    ],
    "icon": "./assets/logo.png"
  }
}
